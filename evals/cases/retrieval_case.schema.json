{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internscout.local/schemas/retrieval-case.schema.json",
  "title": "InternScout Direct Retrieval Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "description",
    "query",
    "top_k",
    "expected_job_id"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "expected_job_id": {
      "type": "integer",
      "minimum": 1
    }
  }
}
