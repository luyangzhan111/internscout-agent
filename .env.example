# Copy to .env if you need to configure an optional provider for Compose.
# The job library, manual imports, eligibility checks and rule recommendations
# work with the provider settings blank.
# Direct Python processes read these settings from their environment.

# Backend / DeepSeek provider configuration (optional; set both to enable)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# OpenAI-compatible embedding provider configuration
# Alibaba Cloud Bailian example: https://dashscope.aliyuncs.com/compatible-mode/v1
INTERNSCOUT_EMBEDDING_API_KEY=
INTERNSCOUT_EMBEDDING_BASE_URL=
INTERNSCOUT_EMBEDDING_MODEL=text-embedding-v4
INTERNSCOUT_EMBEDDING_DIMENSIONS=1024

# Backend database location
# Local default; keep this value for direct local development.
INTERNSCOUT_DATABASE_URL=sqlite:///./internscout.db
# Docker example:
# INTERNSCOUT_DATABASE_URL=sqlite:////data/internscout.db

# Streamlit Demo configuration
# Local default: http://127.0.0.1:8000
INTERNSCOUT_API_BASE_URL=http://127.0.0.1:8000
INTERNSCOUT_API_TIMEOUT_SECONDS=60
