FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/internscout

WORKDIR /opt/internscout

COPY requirements.txt .

RUN python -m pip install --no-cache-dir -r requirements.txt

COPY demo ./demo

RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /opt/internscout

USER appuser

EXPOSE 8501

CMD ["python", "-m", "streamlit", "run", "demo/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
