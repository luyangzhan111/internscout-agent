# Copy this file to .env and replace the placeholder values.
#
# Docker Compose reads .env automatically. Direct local Python processes do
# not load .env automatically; export these variables in the process
# environment when using the DeepSeek-backed Agent API locally.

# Backend / DeepSeek provider configuration
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=replace-with-your-deepseek-model

# Streamlit Demo configuration
# Local default: http://127.0.0.1:8000
INTERNSCOUT_API_BASE_URL=http://127.0.0.1:8000
INTERNSCOUT_API_TIMEOUT_SECONDS=60
